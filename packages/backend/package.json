{
  "name": "backend",
  "version": "0.0.1",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./kkloader": "./src/kkloader/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "bun check src/index.ts src/kkloader/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@echbox/shared": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@msgpack/msgpack": "^3.1.3",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11"
  }
}
